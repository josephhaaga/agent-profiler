{
  "name": "opencode-agent-profiler",
  "version": "0.0.0-dev",
  "description": "OpenCode plugin: ship traces to agent-profiler (local-first AI agent observability)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josephhaaga/agent-profiler.git"
  },
  "keywords": [
    "opencode",
    "opentelemetry",
    "openinference",
    "tracing",
    "observability",
    "llm",
    "agent-profiler"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.json",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "test:e2e": "bun run test/harness/run-e2e.ts",
    "test:e2e:record": "bun run test/harness/run-e2e.ts --record"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0",
    "@arizeai/openinference-core": "^2.8.1",
    "@arizeai/openinference-semantic-conventions": "^2.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22"
  }
}
